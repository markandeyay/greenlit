# Copy to .env.local and fill in. Without real keys the app runs on the in-memory adapter and
# the bundled fixture film library.

# TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limits, cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# YYYY-MM-DD in America/New_York; Reel No. 001 is this day
NEXT_PUBLIC_LAUNCH_DATE=2026-10-01
